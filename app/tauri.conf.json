{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solidway",
  "version": "0.5.0-rc.1",
  "identifier": "xyz.solidway.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local AI gateway desktop app",
    "longDescription": "Solidway desktop app: launches and monitors the local Solidway gateway, then opens its console in the system webview.",
    "copyright": "Copyright © 2026 solidway.xyz",
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "perMachine"
      },
      "wix": {
        "language": [
          "en-US",
          "zh-CN"
        ]
      }
    }
  },
  "mainBinaryName": "SolidwayApp"
}
